projectId: "{{.projectId}}"
displayName: "{{.displayName}}"
swarmId: "{{.projectId}}-swarm"
defaultWorkflowId: "adaptive"

defaultPriority: 40
maxConcurrentTasks: 1

autonomy:
  enabled: false
  # Observe first (GitHub #602): record what autonomy would start, start
  # nothing. Set to false once the would-starts look right.
  observe: true

permissions:
  secrets: []
  allowedTools:
    - "current_time"
    - "file_read"
    - "read_many_files"
    - "memory_search"

firewall:
  mode: ""  # inherit daemon default
