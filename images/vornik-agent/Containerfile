# vornik-agent — LLM-backed agent container
# Reads /app/input/task.json, calls an OpenAI-compatible LLM, writes /app/output/result.json
#
# Build from repo root (uses the calling user's uid/gid so bind mounts
# work without permission gymnastics under --userns=host):
#   make build-agent
#
# Or build explicitly:
#   podman build -f images/vornik-agent/Containerfile \
#     --build-arg VORNIK_UID=$(id -u) \
#     --build-arg VORNIK_GID=$(id -g) \
#     -t vornik-agent:latest .
#
# The defaults (1000:1000) are a reasonable non-root baseline when the
# builder doesn't pass args — e.g. CI smoke tests — but local operator
# builds should always match the running daemon's uid/gid.
#
# Rebuild ONLY via `make build-agent` (auto-sets VORNIK_UID/GID to your uid).
# A bare `podman build` defaults uid to 1000 and breaks rootless workspace
# mounts even under keep-id. See https://docs.vornik.io F3.

ARG VORNIK_UID=1000
ARG VORNIK_GID=1000

FROM golang:1.25@sha256:d7912cedddfa15b2900a8dfb7187df0af5ec2cb424a371139b5b352fd3e6b740 AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /bin/mcp-bridge ./cmd/mcp-bridge \
 && CGO_ENABLED=0 GOOS=linux go build -o /bin/vornik-agent-helper ./cmd/agent-helper

# whisper.cpp's CLI for the sandboxed speech tools (process-spawn law S5,
# https://docs.vornik.io §7): voice STT
# and audio extraction run it in a network-less one-shot of THIS image instead
# of on the daemon host. Built from a pinned commit (the v1.8.7 tag) as a
# static binary; models are never baked in, they are mounted read-only.
FROM ubuntu:24.04@sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90 AS whisper
ARG WHISPER_CPP_COMMIT=48f628a84833905ee4a0658ee6d4a5c915ce1997
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake git ca-certificates \
 && rm -rf /var/lib/apt/lists/*
RUN git clone https://github.com/ggml-org/whisper.cpp /src/whisper.cpp \
 && git -C /src/whisper.cpp checkout --quiet "${WHISPER_CPP_COMMIT}" \
 && test "$(git -C /src/whisper.cpp rev-parse HEAD)" = "${WHISPER_CPP_COMMIT}" \
 && cmake -S /src/whisper.cpp -B /src/build -DBUILD_SHARED_LIBS=OFF \
      -DWHISPER_BUILD_TESTS=OFF -DGGML_NATIVE=OFF -DCMAKE_BUILD_TYPE=Release \
 && cmake --build /src/build --target whisper-cli -j"$(nproc)" \
 && install -m 0755 /src/build/bin/whisper-cli /usr/local/bin/whisper-cli

# piper's release bundle (binary + its espeak-ng data and onnxruntime), pinned
# by sha256 per architecture. Voice TTS runs it in the sandbox (S5).
FROM ubuntu:24.04@sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90 AS piper
ARG TARGETARCH
ARG PIPER_RELEASE=2023.11.14-2
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
RUN set -e; \
    case "${TARGETARCH:-amd64}" in \
      amd64) arch=x86_64;  sum=a50cb45f355b7af1f6d758c1b360717877ba0a398cc8cbe6d2a7a3a26e225992 ;; \
      arm64) arch=aarch64; sum=fea0fd2d87c54dbc7078d0f878289f404bd4d6eea6e7444a77835d1537ab88eb ;; \
      *) echo "unsupported TARGETARCH ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -sSL -o /tmp/piper.tgz "https://github.com/rhasspy/piper/releases/download/${PIPER_RELEASE}/piper_linux_${arch}.tar.gz"; \
    echo "${sum}  /tmp/piper.tgz" | sha256sum -c -; \
    tar -xzf /tmp/piper.tgz -C /opt

FROM ubuntu:24.04@sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90
# Build provenance (2026-08-25). The revision label is what makes image
# staleness detectable at all: doctor's image_freshness check compares it
# against the daemon's own build revision, and vornik-update.sh reads it to
# skip rebuilding an image that is already current. Re-declared after FROM
# because build args do not cross stage boundaries. A value of `unknown` means
# the image was built by hand without passing them.
ARG VORNIK_REVISION=unknown
ARG VORNIK_VERSION=dev
LABEL org.opencontainers.image.revision="${VORNIK_REVISION}" \
      org.opencontainers.image.version="${VORNIK_VERSION}" \
      org.opencontainers.image.source="https://github.com/EaseIT-cz/vornik"

# Re-declare ARGs after FROM — build args don't cross stage boundaries.
ARG VORNIK_UID
ARG VORNIK_GID

RUN apt-get update && apt-get install -y --no-install-recommends \
    jq curl coreutils git git-lfs openssh-client bash make \
    python3 python-is-python3 pip python3-venv python3-pytest \
    python3-numpy python3-scipy mypy \
    imagemagick \
    pandoc weasyprint fonts-dejavu \
    poppler-utils tesseract-ocr tesseract-ocr-eng ffmpeg \
    gcc libc6-dev \
    gnupg \
    && rm -rf /var/lib/apt/lists/*

# Python ergonomics for agent run_shell on Python projects (e.g. headmatch):
#   - python-is-python3 provides `python` (Ubuntu ships only `python3`), so a
#     project's `python ...` / README commands don't hit "python: not found"
#     (incident 2026-06-13: headmatch coder spent iterations recovering).
#   - PIP_BREAK_SYSTEM_PACKAGES lets `pip install -r requirements.txt` work in
#     the throwaway agent container despite PEP-668's externally-managed guard
#     (the container is ephemeral — no host site-packages to pollute). Agents
#     can still make a venv when a project needs isolation.
#   - numpy + scipy pre-bundled (the common scientific base) so the most
#     frequent imports don't wait on per-task egress installs.
#   - mypy pre-bundled so the `typecheck_run` tool works on Python projects
#     (2026-07-09: a hardened github-review on headmatch #34 couldn't run
#     `python -m mypy` — "mypy is not installed" — and fell back to inspection).
#     Project-specific runtime deps (e.g. headmatch's soundfile/pyyaml) are NOT
#     baked here. A project that declares `dependencies:` gets them installed
#     by the operator (`vornikctl deps install`, inside THIS image) and mounted
#     read-only for every role; one that does not still has the coder
#     pip-install per task (PIP_BREAK_SYSTEM_PACKAGES).
ENV PIP_BREAK_SYSTEM_PACKAGES=1

# GitHub CLI (gh) — the github-router workflow uses it for outbound GitHub
# writes (gh pr review / gh pr create), authenticated by the GH_TOKEN the
# daemon injects per task from the project's `github` App credentials.
RUN install -d -m 755 /etc/apt/keyrings \
 && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
 && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends gh \
 && rm -rf /var/lib/apt/lists/*

# pandoc + weasyprint enable the research-swarm writer role to
# convert its markdown deliverable to PDF / HTML / DOCX / EPUB /
# RTF / ODT via `pandoc -o`. weasyprint is the headless PDF engine
# (no LaTeX toolchain — ~150MB instead of ~1.5GB). fonts-dejavu is
# the minimal sans/serif/mono trio weasyprint needs so PDFs don't
# render as tofu when the markdown specifies no font. See
# configs/swarms/{assistant,jankas}-swarm.yaml writer role.

# gcc + libc6-dev are required for CGO. Without them, `go test -race`
# (which mandates CGO) fails with "cgo: C compiler not found".
# build-essential pulls dpkg-dev / make / g++ which we don't need;
# gcc + libc6-dev are the minimal pair Go's race detector links against.
# Added 2026-05-08 after a coverage agent reported "go test -race
# requires cgo/gcc which is not available".

# Non-root user for the agent process. The uid/gid are build args so
# operators can match their host uid, making bind-mounted /app/input,
# /app/output, and /app/workspace writable without --userns=keep-id
# trickery or world-writable host directories.
#
# Ubuntu 24.04+ base images ship with a default 'ubuntu' user that may
# collide with the target uid; delete it and any system user already
# holding the uid/gid before creating ours.
# /home/vornik is created by --create-home and used as HOME for git
# and ssh operations that default to reading $HOME/.ssh, $HOME/.gitconfig.
RUN userdel --remove ubuntu 2>/dev/null || true \
 && if getent passwd "$VORNIK_UID" >/dev/null; then userdel --remove "$(getent passwd $VORNIK_UID | cut -d: -f1)" 2>/dev/null || true; fi \
 && if getent group "$VORNIK_GID" >/dev/null; then groupdel "$(getent group $VORNIK_GID | cut -d: -f1)" 2>/dev/null || true; fi \
 && groupadd --gid "$VORNIK_GID" vornik \
 && useradd --uid "$VORNIK_UID" --gid "$VORNIK_GID" --create-home --shell /bin/bash vornik \
 && mkdir -p /app/input /app/output /app/workspace \
 && chown -R vornik:vornik /app \
 && chmod 1777 /app/input /app/output /app/workspace /home/vornik

COPY --from=whisper /usr/local/bin/whisper-cli /usr/local/bin/whisper-cli
COPY --from=piper /opt/piper /opt/piper
RUN ln -s /opt/piper/piper /usr/local/bin/piper
COPY --from=builder /bin/mcp-bridge /usr/local/bin/mcp-bridge
COPY --from=builder /bin/vornik-agent-helper /usr/local/bin/vornik-agent-helper

# Carry the Go toolchain forward from the builder stage so agent
# tasks on Go projects (e.g. the vornik-autocoder coverage workflow)
# can run `go test`, `go build`, `go vet`, `go tool cover`. Without
# this, the agent's shell tool returns "go: not found" and the
# coverage-refresh task fabricates a "no testable files" report
# (observed vornik-autocoder/CANNOT_RUN_COVERAGE.md, 2026-05-05).
# GOCACHE / GOMODCACHE point under the vornik user's HOME so
# go test can write its build cache without root.
COPY --from=builder /usr/local/go /usr/local/go
ENV PATH=/usr/local/go/bin:$PATH \
    GOPATH=/home/vornik/go \
    GOCACHE=/home/vornik/.cache/go-build \
    GOMODCACHE=/home/vornik/go/pkg/mod

# The image must work when the process runs as a uid it did not bake.
#
# Incident 2026-09-17/18: the published image bakes 1000 because CI does not
# pass VORNIK_UID, and on a uid-1001 host every agent step died on permission
# denied — 9 hours of total outage. runtime.run_as_user (podman --user) fixes
# WHO the process is but cannot fix what the image OWNS, so without this the
# workspace came back and every `go build` inside the agent still failed on an
# unwritable GOCACHE — the coder role's whole function, broken quietly.
#
# 1777 is the /tmp convention: any uid may write, the sticky bit stops one
# deleting another's files. It is bounded by this container's own filesystem —
# these paths are not shared between containers — so it is not the
# world-writable HOST directory the design's non-goals reject.
#
# VORNIK_UID/VORNIK_GID are still honoured: `make build-agent` bakes a matching
# uid, which stays the tidiest arrangement. It is simply no longer what makes
# the image work. Pinned by images/vornik-agent/test-image-uid-agnostic.sh.
RUN mkdir -p /home/vornik/go/pkg/mod /home/vornik/.cache/go-build \
 && chown -R vornik:vornik /home/vornik \
 && chmod -R a+rwX /home/vornik \
 && chmod 1777 /home/vornik /home/vornik/go /home/vornik/go/pkg /home/vornik/go/pkg/mod \
               /home/vornik/.cache /home/vornik/.cache/go-build

COPY --chown=vornik:vornik images/vornik-agent/entrypoint.sh /entrypoint.sh
# The generated tool registry the entrypoint sources (internal/agenttools -> docs-gen tools).
COPY --chown=vornik:vornik images/vornik-agent/tool_registry.generated.sh /tool_registry.generated.sh
RUN chmod +x /entrypoint.sh

# Declares that this image works as ANY uid (the 1777 paths above), so the
# daemon's agent_image_uid doctor check can answer without starting a
# container. `podman image inspect` reads it in ~55ms; the `id -u` probe it
# replaces takes 5.92-12.55s cold on this 1.3GB image and is what CE issue 59
# reports being SIGKILLed by its own deadline on every doctor run.
#
# The value is the contract version, so a future change to which paths are
# writable can bump it rather than having to invent a second label.
LABEL io.vornik.agent.uid-agnostic="1"

# The tools this image offers the daemon's sandboxed one-shots (process-spawn
# law S5, design §7.1 decision 4). The daemon reads it from the pinned image and
# reports a feature whose tool is absent as "not available" rather than ever
# running it on the host; vornikctl doctor RUNS each one to verify function.
LABEL io.vornik.sandbox-tools="pdftotext,tesseract,ffmpeg,ffprobe,whisper-cli,piper"

WORKDIR /app/workspace
USER vornik:vornik

ENTRYPOINT ["/entrypoint.sh"]
